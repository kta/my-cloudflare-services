{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "treatConfigHintsAsErrors": true,
  "ignoreDependencies": ["^cloudflare(:.*)?$"],
  "ignoreFiles": [".agents/skills/design-select/scripts/**"],
  "workspaces": {
    "packages/contracts": {
      "entry": ["test/**/*.test.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"],
      "vitest": false
    },
    "packages/shared": {
      "entry": ["test/**/*.test.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"],
      "vitest": false
    },
    "packages/ui": {
      "entry": ["src/**/*.test.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "services/admin": {
      "entry": ["test/**/*.test.ts", "vitest.config.ts", "src/web/**/*.test.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx,css}", "test/**/*.ts", "e2e/**/*.ts", "*.ts", "*.mjs"],
      "vitest": false
    },
    "services/glasses_management": {
      "entry": [
        "test/**/*.test.ts",
        "vitest.config.ts",
        "src/web/**/*.test.{ts,tsx}",
        // 画面証跡の撮影スクリプト。spec ではないので Playwright は収集しないが、
        // 手動で実行する入口なので未使用ではない。
        "e2e/screens.capture.ts",
        // 承認済みモックとの突き合わせ一式。同じく手動で実行する入口。
        "e2e/mock-reference.capture.ts",
        "e2e/gallery.diff.ts",
        "e2e/overlay.ts",
        "e2e/*.mjs"
      ],
      "project": ["src/**/*.{ts,tsx,css}", "test/**/*.ts", "e2e/**/*.{ts,mjs}", "*.ts"],
      "vitest": false
    },
    "services/example_service": {
      "entry": ["test/**/*.test.ts", "vitest.config.ts", "src/web/**/*.test.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx,css}", "test/**/*.ts", "e2e/**/*.ts", "*.ts"],
      "vitest": false
    }
  }
}
