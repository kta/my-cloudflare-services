# ローカル開発用の dev 値。`make init` が .dev.vars にコピーする(.dev.vars は gitignore)。
# 本番は `wrangler secret put` で設定(docs/howto/deploy.md)。
INTERNAL_KEY=dev-internal-key
# admin と glasses_management の PIN 再認証 service binding 専用キー。
# INTERNAL_KEY や JWT_SECRET と同じ値にしてはいけない。
DOMAIN_AUTH_KEY=dev-domain-auth-key
JWT_SECRET=dev-jwt-secret-change-me
AUTH_PEPPER=dev-auth-pepper-change-me
# credential 無しの dev トークングラント(/api/auth/token)を有効化。本番では設定しない(fail close)。
AUTH_DEV_GRANT=true
