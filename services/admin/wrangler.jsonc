{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "admin",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-06-25",
  "observability": { "enabled": true },
  // One Worker serves the admin SPA (static assets) and its API (/api/*).
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // admin owns the canonical `organizations` table + auth tables (its own D1).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "admin",
      "database_id": "0388dd19-68f7-4d34-a5bb-818b84205548",
      "migrations_dir": "migrations"
    }
  ],
  // Rate-limit / lockout counters for login (email+IP window). Free tier.
  "kv_namespaces": [{ "binding": "AUTH_RL", "id": "ec31896881954c4aa932a4a72b1a08be" }],
  // Domain services receive canonical organization snapshots through an
  // internal service binding. The receiving Worker still verifies
  // x-internal-key, so a binding alone never grants access.
  "services": [{ "binding": "GLASSES_MANAGEMENT", "service": "glasses-management" }],
  // No secrets in `vars` (official guidance): INTERNAL_KEY / JWT_SECRET /
  // AUTH_PEPPER / AUTH_DEV_GRANT live in .dev.vars for local dev (copied from
  // .dev.vars.example by `make init`) and are set via `wrangler secret put` in
  // prod. Until secrets are set, everything fails closed. See docs/howto/deploy.md.
  "vars": {
    // INVITE_BASE_URL(任意): 招待リンクの基底 URL の明示オーバーライド。
    // 既定はリクエスト origin から導出されるので通常は不要。
    "INVITE_BASE_URL": ""
  },
  // staging。GLASSES_MANAGEMENT は staging の Worker を指す(binding にサフィックスは付かない)。
  // 各 id は Terraform(envs/staging) の出力の実値に差し替える。
  "env": {
    "staging": {
      "assets": {
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/api/*"]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "admin_staging",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "migrations"
        }
      ],
      "kv_namespaces": [{ "binding": "AUTH_RL", "id": "00000000000000000000000000000000" }],
      "services": [{ "binding": "GLASSES_MANAGEMENT", "service": "glasses-management-staging" }],
      "vars": { "INVITE_BASE_URL": "" }
    }
  }
}
