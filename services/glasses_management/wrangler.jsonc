{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "glasses-management",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-06-25",
  "observability": { "enabled": true },
  // 1 つの Worker が業務 SPA（iPad）とお客様向け Web 予約（スマートフォン）と
  // API を同一オリジンで配る。/api/* だけが Worker に届き、他は静的資産として
  // 返る（SPA fallback）。`directory` は Cloudflare Vite プラグインが埋める。
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // 1 ドメイン = 1 D1。database_id は Terraform 出力
  // (`glasses_management_d1_database_id`) の実 UUID に差し替えてから remote へ出す。
  // local dev / test はこの値を見ない。`migrations_dir` は drizzle の `out` と一致させる。
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "glasses_management",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  // 短命な状態（冪等キー・受付中の下書き）だけを置く。正本は D1。
  // id は Terraform 出力 `glasses_management_short_lived_kv_namespace_id`。
  "kv_namespaces": [{ "binding": "SHORT_LIVED", "id": "00000000000000000000000000000000" }],
  // 受付録音と手書きメモの本体。非公開のまま Worker が仲介し、ダウンロード URL は発行しない。
  "r2_buckets": [{ "binding": "RECORDINGS", "bucket_name": "glasses-management-recordings" }],
  // 予約確定メールと管理コード発行メールは notifier へ同期送信する
  // （service binding + x-internal-key）。Queues は使わない。
  "services": [{ "binding": "NOTIFIER", "service": "notifier" }],
  // 日次の保守。**UTC で書く**ので 14:55 = JST 23:55（閉店後・日付が変わる前）。
  // アカウント全体の Cron 枠 5 本のうち、このサービスが 1 本目を使う
  // （specs/glasses_management/design/04-api.md §3.2）。保持期限を過ぎた録音の掃除と、
  // 24 時間動かない録音を failed に落とす処理をこの 1 本の中で順に呼ぶ。
  "triggers": { "crons": ["55 14 * * *"] }
  // secrets（INTERNAL_KEY / JWT_SECRET / AUTH_DEV_GRANT）は vars に置かない。
  // dev は .dev.vars、本番は `wrangler secret put`。docs/howto/deploy.md 参照。
}
